{
  "type": "object",
  "properties": {
    "at": {
      "type": "string",
      "description": "ISO-8601 BF event-occurrence time."
    },
    "code": {
      "type": "string",
      "description": "Machine-readable error code (e.g. broker_disconnected)."
    },
    "command_type": {
      "type": "string",
      "description": "The broker.* command that failed (e.g. broker.get_account)."
    },
    "message": {
      "type": "string",
      "description": "Human-readable error detail."
    }
  },
  "additionalProperties": true,
  "required": [
    "code",
    "command_type"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/payloads/broker.error.json",
  "title": "payload: broker.error",
  "description": "NACK for any broker.* command (get_account/get_orders/get_catalog/get_instrument/resolve_instrument). Correlated to the request via correlation_id."
}
