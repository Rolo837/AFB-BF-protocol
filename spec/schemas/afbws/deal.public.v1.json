{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/afbws/deal.public.v1.json",
  "title": "Public deal projection (AFB backend -> AFB frontend only; not part of afb.execution.v1 wire)",
  "description": "Explicit allow-list projector output over afb.deal.v1/v2 (../deal.v1.json, ../deal.v2.json), built by backend/trade/public_views.py — never a serialization of the persisted DealState file. Deliberately NOT an allOf+$ref extension of the whole wire root: those wire schemas declare `owner`/`archive_reason` in their own `properties` with no `additionalProperties: false`, so those fields would count as already-'evaluated' and survive an outer `unevaluatedProperties: false` — the only way to actually drop them is to define this object's own shape directly and reuse the wire schemas' field-level $defs (target, sizing, conditions, execution policy) rather than their root. `source` is strict and requires `tradeplan_id` — the single public link back to the owning tradeplan; `source.kind`/`draft_id`, compile snapshots and raw phase-B overrides never appear here.",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": ["tradeplan_id"],
      "additionalProperties": false,
      "properties": {
        "tradeplan_id": { "type": "string", "minLength": 1 }
      }
    },
    "v1": {
      "type": "object",
      "required": ["schema", "deal_id", "revision", "target", "direction", "entry", "sizing", "source"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "afb.deal.v1" },
        "deal_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "target": { "$ref": "../deal.v1.json#/$defs/target" },
        "direction": { "enum": ["long", "short"] },
        "entry": { "$ref": "../deal.v1.json#/$defs/entry" },
        "sizing": { "$ref": "../deal.v1.json#/$defs/sizing" },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "take_profit": { "$ref": "../deal.v1.json#/$defs/exitBlock" },
            "stop_loss": { "$ref": "../deal.v1.json#/$defs/exitBlock" }
          }
        },
        "execution_policy": { "$ref": "../deal.v1.json#/$defs/executionPolicy" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "v2": {
      "type": "object",
      "required": ["schema", "deal_id", "revision", "target", "direction", "entry", "sizing", "source"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "afb.deal.v2" },
        "deal_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "target": { "$ref": "../deal.v1.json#/$defs/target" },
        "direction": { "enum": ["long", "short"] },
        "entry": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["condition"],
            "additionalProperties": false,
            "properties": {
              "percent": { "$ref": "../deal.v1.json#/$defs/decimalString" },
              "logic": { "$ref": "../deal.v2.json#/$defs/legJoin" },
              "condition": { "$ref": "../deal.v2.json#/$defs/conditionNode" }
            }
          }
        },
        "stop_loss": { "$ref": "#/$defs/exitList" },
        "take_profit": { "$ref": "#/$defs/exitList" },
        "sizing": { "$ref": "../deal.v1.json#/$defs/sizing" },
        "execution_policy": { "$ref": "../deal.v1.json#/$defs/executionPolicy" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "exitList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition"],
        "additionalProperties": false,
        "properties": {
          "percent": { "$ref": "../deal.v1.json#/$defs/decimalString" },
          "logic": { "$ref": "../deal.v2.json#/$defs/legJoin" },
          "condition": { "$ref": "../deal.v2.json#/$defs/conditionNode" }
        }
      }
    }
  }
}
