{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/afbws/alarm.channel.v2.json",
  "x-afbws-support-id": "afbws.alarm.channel.v2",
  "title": "alarm channel — schema-first (AFB backend<->AFB frontend only; not part of afb.execution.v1 wire)",
  "description": "Negotiated via auth.support/auth_ok.support (capability id afbws.alarm.channel.v2). Items are afb.alarm.v2 (`instrument_key` instead of `ticker`). Same convention as afbws.market: ONE schema id per message (`afbws.alarm.<op>.v2`, no .request/.response/.push suffixes); the same schema is the request and its response (a response echoes `request_id`). Collections are arrays (`items[]`, `ids[]`, `instrument_keys[]`), so bulk operations are single messages; partial failures come back in `rejected[]`. `triggered` is the only server push (no `request_id`). A client negotiates v1 or v2 (v2 preferred if both are offered); the backend answers in the negotiated version only. See AFB/docs/ENTITY_WS_PROTOCOL.md.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/list"
    },
    {
      "$ref": "#/$defs/set"
    },
    {
      "$ref": "#/$defs/delete"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/triggered"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "list": {
      "type": "object",
      "title": "afbws.alarm.list.v2 — read alarms (request / response).",
      "description": "Request: optional filters `ids[]` and/or `instrument_keys[]` (both = intersection; none = every alarm of the caller). Response (same `request_id`): `items[]` (afb.alarm.v2). There is no separate `get`: use `ids`. A request carrying `items` is invalid.",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "alarm"
        },
        "schema": {
          "const": "afbws.alarm.list.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instrument_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.json#/$defs/instrumentKey"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../alarm.v2.json"
          }
        }
      },
      "not": {
        "required": [
          "items"
        ],
        "anyOf": [
          {
            "required": [
              "ids"
            ]
          },
          {
            "required": [
              "instrument_keys"
            ]
          }
        ]
      }
    },
    "set": {
      "type": "object",
      "title": "afbws.alarm.set.v2 — upsert alarms (request / response / server push).",
      "description": "Request (`request_id` present): `items[]` — upsert by `item.id`, batched. Response (same `request_id`): applied `items[]` (authoritative records, possibly empty) + `rejected[]` for items that were not applied. Push (no `request_id`, server-initiated): `items[]` (at least one) are authoritative afb.alarm.v2 records that the server created or changed on its own (e.g. alarms moved to another contract by the expiration replace) — upsert by id on the client, never a snapshot; `rejected` is not allowed. Removal is conveyed by `afbws.alarm.delete.v2` without `request_id`.",
      "required": [
        "channel",
        "schema",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "alarm"
        },
        "schema": {
          "const": "afbws.alarm.set.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../alarm.v2.json"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejection"
          }
        }
      },
      "dependentRequired": {
        "rejected": [
          "request_id"
        ]
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "request_id"
              ]
            }
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "delete": {
      "type": "object",
      "title": "afbws.alarm.delete.v2 — delete alarms (request / response / server push).",
      "description": "Request (`request_id` present): `ids[]` and/or `instrument_keys[]` (at least one; `instrument_keys` = every alarm of those instruments). Response (same `request_id`): `ids[]` actually removed (possibly empty) + `rejected[]`. Push (no `request_id`): `ids[]` (at least one) removed by the server on its own (e.g. alarms of an expired contract cleaned by the expiration policy); `instrument_keys`/`rejected` are not allowed.",
      "required": [
        "channel",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "alarm"
        },
        "schema": {
          "const": "afbws.alarm.delete.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instrument_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.json#/$defs/instrumentKey"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejection"
          }
        }
      },
      "dependentRequired": {
        "rejected": [
          "request_id"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "request_id"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "ids"
                ]
              },
              {
                "required": [
                  "instrument_keys"
                ]
              }
            ]
          },
          "else": {
            "required": [
              "ids"
            ],
            "properties": {
              "ids": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "instrument_keys"
              ]
            }
          }
        }
      ]
    },
    "rejection": {
      "type": "object",
      "title": "One alarm that was not applied by set/delete.",
      "required": [
        "id",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "$ref": "common.v1.json#/$defs/errorCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "triggerEvent": {
      "type": "object",
      "required": [
        "schema",
        "alarm_id",
        "triggered_at",
        "alarm"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "afb.alarm.trigger.v2"
        },
        "alarm_id": {
          "type": "string",
          "minLength": 1
        },
        "triggered_at": {
          "type": "string",
          "minLength": 1
        },
        "alarm": {
          "$ref": "../alarm.v2.json"
        },
        "current_price": {
          "type": "number"
        }
      }
    },
    "triggered": {
      "type": "object",
      "title": "afbws.alarm.triggered.v2 — alarm fired (server push, no request_id).",
      "description": "Server-initiated; `events[]` carry the fired alarm with its authoritative afb.alarm.v2 record.",
      "required": [
        "channel",
        "schema",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "alarm"
        },
        "schema": {
          "const": "afbws.alarm.triggered.v2"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/triggerEvent"
          }
        }
      }
    },
    "ackEvent": {
      "type": "object",
      "required": [
        "schema",
        "alarm_id",
        "triggered_at"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "afb.alarm.trigger_ack.v2"
        },
        "alarm_id": {
          "type": "string",
          "minLength": 1
        },
        "triggered_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ackResultItem": {
      "type": "object",
      "required": [
        "schema",
        "alarm_id",
        "triggered_at",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "afbws.alarm.ack_result.v2"
        },
        "alarm_id": {
          "type": "string",
          "minLength": 1
        },
        "triggered_at": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "not_found"
          ]
        }
      }
    },
    "ack": {
      "type": "object",
      "title": "afbws.alarm.ack.v2 — acknowledge fired alarms (request / response).",
      "description": "Request: `events[]` (afb.alarm.trigger_ack.v2), at least one. Response (same `request_id`): `results[]` — one per event, `status` ok | not_found. A request carrying `results` is invalid.",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "alarm"
        },
        "schema": {
          "const": "afbws.alarm.ack.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ackEvent"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ackResultItem"
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "events"
              ],
              "not": {
                "required": [
                  "results"
                ]
              }
            },
            {
              "required": [
                "results"
              ],
              "not": {
                "required": [
                  "events"
                ]
              }
            }
          ]
        }
      ]
    },
    "error": {
      "type": "object",
      "title": "afbws.alarm.error.v2 — typed error for a whole request (server -> client).",
      "description": "Per-item failures of a batched set/delete are reported in that response's `rejected[]`, not here.",
      "required": [
        "channel",
        "schema",
        "request_id",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "alarm"
        },
        "schema": {
          "const": "afbws.alarm.error.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "code": {
          "$ref": "common.v1.json#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
