{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/deal.v1.json",
  "title": "ExecutionDeal afb.deal.v1",
  "description": "Single-entry / single-exit deal. All prices, steps, sizing values and thresholds are decimal STRINGS. The deal-level `direction` (long/short, same vocabulary as afb.deal.v2) is the single source of truth for position bias. Shared $defs (decimalString/instrument/target/sizing/executionPolicy/source) live in common.v1.json — this file keeps only what's v1-specific (conditionNode/entry/exitBlock); see common.v1.json's description for why.",
  "type": "object",
  "required": ["schema", "deal_id", "revision", "target", "direction", "entry", "sizing"],
  "properties": {
    "schema": {"const": "afb.deal.v1"},
    "deal_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "owner": {"type": "object", "properties": {"user_id": {"type": "string"}}},
    "target": {"$ref": "common.v1.json#/$defs/target"},
    "direction": {"enum": ["long", "short"]},
    "entry": {"$ref": "#/$defs/entry"},
    "sizing": {"$ref": "common.v1.json#/$defs/sizing"},
    "risk": {
      "type": "object",
      "properties": {
        "take_profit": {"$ref": "#/$defs/exitBlock"},
        "stop_loss": {"$ref": "#/$defs/exitBlock"}
      }
    },
    "execution_policy": {"$ref": "common.v1.json#/$defs/executionPolicy"},
    "archive_reason": {"type": "string"},
    "source": {"$ref": "common.v1.json#/$defs/source"}
  },
  "$defs": {
    "conditionNode": {
      "type": "object",
      "required": ["node_type", "op", "left", "right"],
      "properties": {
        "node_type": {"const": "event"},
        "id": {"type": "string"},
        "op": {"enum": ["above", "below", "crosses_above", "crosses_below", "crossing"]},
        "left": {
          "type": "object",
          "required": ["source"],
          "description": "afb.deal.v1 conditions compare against the last traded price, or (entry only — see executor-side validation) fire immediately with no price level of its own. quote/indicator/dataset sources are afb.deal.v2-only.",
          "properties": {
            "source": {"enum": ["price", "immediate"]},
            "field": {"const": "last"}
          }
        },
        "right": {
          "type": "object",
          "required": ["const"],
          "properties": {"const": {"$ref": "common.v1.json#/$defs/decimalString"}}
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "condition": {"$ref": "#/$defs/conditionNode"}
      }
    },
    "exitBlock": {
      "type": "object",
      "properties": {"condition": {"$ref": "#/$defs/conditionNode"}}
    }
  }
}
