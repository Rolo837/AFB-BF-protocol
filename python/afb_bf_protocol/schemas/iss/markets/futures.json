{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/iss/markets/futures.json",
  "title": "ISS securities: engines/futures/markets/forts",
