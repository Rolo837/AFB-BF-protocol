{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/afbws/instrument.channel.v2.json",
  "x-afbws-support-id": "afbws.instrument.channel.v2",
  "title": "instrument channel v2 — schema-first (AFB backend<->AFB frontend only; not part of afb.execution.v1 wire)",
  "description": "Negotiated via auth.support/auth_ok.support (capability id afbws.instrument.channel.v2). Replaces afbws.instrument.channel.v1 (deprecated, still served to clients that did not negotiate v2) with only the operations the project uses and that afbws.catalog.channel.v1 does not already cover. Same convention as afbws.catalog/afbws.alarm.v2/afbws.gp.v2: ONE schema id per message (`afbws.instrument.<op>.v2`), the same schema is the request, its response and, for `expiration`, the server push; a message WITHOUT `request_id` is a server push; a failed request is answered with `afbws.instrument.error.v2`. Operations: `catalog`, `sets`, `favorites`, `paint`, `expiration`, `replace`, `detail`. Instruments are addressed ONLY by `instrument_key`; `ticker` appears solely as a display attribute of a listing / notice. All operations are open to any authenticated caller; manager rights (global sets) are checked by the backend per `visibility`. See AFB/docs/ws/instrument.md.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/sets"
    },
    {
      "$ref": "#/$defs/favorites"
    },
    {
      "$ref": "#/$defs/paint"
    },
    {
      "$ref": "#/$defs/expiration"
    },
    {
      "$ref": "#/$defs/replace"
    },
    {
      "$ref": "#/$defs/detail"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "favoriteColor": {
      "enum": [
        "yellow",
        "red",
        "blue",
        "green",
        "gray",
        "orange",
        "cyan",
        "purple",
        "pink",
        "teal"
      ],
      "description": "Same list and order as afbws.instrument.channel.v1#/$defs/favoriteColor and afbws.catalog.channel.v1 (kept in lockstep; no cross-reference on purpose)."
    },
    "collection": {
      "type": "object",
      "required": [
        "id",
        "name",
        "asset_ids"
      ],
      "additionalProperties": false,
      "description": "A node of the category tree; its position in `collections[]` is the display order. `asset_ids` is the ordered composition (assets filed into it).",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "description": "Opaque icon key. Omitted in a request: unchanged; null: clears."
        },
        "icon_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/favoriteColor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Omitted in a request: unchanged; null: clears."
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visibility": {
      "enum": [
        "personal",
        "guest",
        "user",
        "manager"
      ],
      "description": "Who sees a set. `personal` — only its owner (any authenticated caller may create these, within the tier limit `max_sets`). `guest`/`user`/`manager` — a GLOBAL set published for callers whose tier is at least that one; creating, changing or deleting a global set is manager-only (backend gate, `forbidden` otherwise)."
    },
    "set": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "visibility"
      ],
      "additionalProperties": false,
      "description": "A named set of assets (`asset_ids[]`) or of instruments (`instrument_keys[]`), by `type`; exactly the list of its own type is present, always the WHOLE composition in display order. `type` is decided on create and cannot change afterwards.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "asset",
            "instrument"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "icon_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "description": "Opaque icon key. Omitted in a request: unchanged; null: clears."
        },
        "icon_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/favoriteColor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Omitted in a request: unchanged; null: clears."
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instrument_keys": {
          "type": "array",
          "items": {
            "$ref": "common.v1.json#/$defs/instrumentKey"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "asset"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "instrument_keys": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "instrument"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "asset_ids": false
            }
          }
        }
      ]
    },
    "setEdit": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "description": "A set inside `sets` (request / response). Request: `type` (default `asset` on create; on update must equal the stored one) and `visibility` (default `personal` on create; unchanged on update) are optional; the composition list of the set's own type, when present, is the WHOLE composition in final order. Response: every field of `set` is present.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "asset",
            "instrument"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "icon_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "description": "Opaque icon key. Omitted in a request: unchanged; null: clears."
        },
        "icon_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/favoriteColor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Omitted in a request: unchanged; null: clears."
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instrument_keys": {
          "type": "array",
          "items": {
            "$ref": "common.v1.json#/$defs/instrumentKey"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "asset"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "instrument_keys": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "instrument"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "asset_ids": false
            }
          }
        },
        {
          "not": {
            "required": [
              "asset_ids",
              "instrument_keys"
            ]
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "description": "One ordered member of an asset: `listing` (ref = instrument_key) or `derivative` (ref = derivative code `MIC:CODE`).",
      "properties": {
        "kind": {
          "enum": [
            "listing",
            "derivative"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "collection_id",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "collection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      }
    },
    "listing": {
      "type": "object",
      "required": [
        "instrument_key",
        "mic",
        "market",
        "ticker",
        "name",
        "source"
      ],
      "additionalProperties": false,
      "description": "An active catalog listing. `instrument_key` is the identity; `ticker` is a display attribute only (for non-MISX it is `MIC:TICKER`) and is never an address in this channel.",
      "properties": {
        "instrument_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        },
        "mic": {
          "type": "string"
        },
        "board": {
          "type": [
            "string",
            "null"
          ]
        },
        "market": {
          "type": "string"
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "shortname": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "decimals": {
          "type": [
            "integer",
            "null"
          ]
        },
        "lot_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "price_step": {
          "type": [
            "string",
            "null"
          ],
          "description": "Decimal string, never a float."
        },
        "step_price": {
          "type": [
            "string",
            "null"
          ],
          "description": "Decimal string, never a float."
        },
        "expiration": {
          "type": [
            "string",
            "null"
          ]
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        },
        "derivative": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "derivative": {
      "type": "object",
      "required": [
        "code",
        "kind",
        "name",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "perpetual",
            "series",
            "options"
          ]
        },
        "name": {
          "type": "string"
        },
        "underlying_key": {
          "anyOf": [
            {
              "$ref": "common.v1.json#/$defs/instrumentKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "catalog": {
      "type": "object",
      "title": "afbws.instrument.catalog.v2 — working snapshot of the curated catalog (request / response)",
      "description": "Request: only `request_id`. Response (same `request_id`): what the caller may see — ordered `collections`, `sets` (global sets published for the caller's tier plus the caller's own `personal` ones, in display order), `assets` with members, the active `listings` the caller may see and the `derivatives` axis. Completeness is applied by the backend from the caller's role (a manager also sees unassigned assets). `revision` is the global catalog revision (`catalog_revision` of `sets`), `user_revision` the revision of the caller's personal sets aggregate. Any authenticated caller.",
      "required": [
        "channel",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.catalog.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "user_revision": {
          "type": "integer",
          "minimum": 0
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection"
          }
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/set"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "listings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listing"
          }
        },
        "derivatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derivative"
          }
        }
      },
      "oneOf": [
        {
          "maxProperties": 3,
          "not": {
            "required": [
              "revision"
            ]
          }
        },
        {
          "required": [
            "revision",
            "user_revision",
            "collections",
            "sets",
            "assets",
            "listings",
            "derivatives"
          ]
        }
      ]
    },
    "sets": {
      "type": "object",
      "title": "afbws.instrument.sets.v2 — create, change, reorder and delete sets (request / response)",
      "description": "ONE command for all authenticated callers; the only difference between a user and a manager is the `visibility` of the set, checked by the backend. Request: `sets[]` — upsert by `id`, each with its WHOLE composition in final order (omit the list to leave a set's composition untouched); the order of `sets[]` is the display order of the sets (personal ones and global ones are ordered separately); `remove_sets[]` — ids to delete. `visibility` `personal` (default for a new set) is open to everybody within the tier limit `max_sets`; `guest|user|manager` (global set) is manager-only (`forbidden`, `details.set_ids`). A set keeps its scope: switching between `personal` and a global visibility is `validation_error`. CAS: `user_revision` guards the personal sets, `catalog_revision` the global ones; each is required when the request touches that area (stale -> `conflict` with the current revisions in `details`). The request is atomic: if anything is rejected nothing is applied. Response (same `request_id`): both revisions and `sets[]` — the caller's visible sets after the change, in display order (same form as `catalog.sets`).",
      "required": [
        "channel",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.sets.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "user_revision": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 0
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setEdit"
          }
        },
        "remove_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applied": {
          "type": "boolean",
          "const": true,
          "description": "Present (true) only in the response."
        }
      },
      "oneOf": [
        {
          "not": {
            "required": [
              "applied"
            ]
          },
          "required": [
            "request_id"
          ]
        },
        {
          "required": [
            "request_id",
            "applied",
            "user_revision",
            "catalog_revision",
            "sets"
          ]
        }
      ]
    },
    "favoriteRef": {
      "type": "object",
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false,
      "description": "`key` is an `instrument_key` for kind `instrument` and an `asset_id` for kind `asset`.",
      "properties": {
        "kind": {
          "enum": [
            "instrument",
            "asset"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "favoriteEntry": {
      "type": "object",
      "required": [
        "kind",
        "key",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "instrument",
            "asset"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/favoriteColor"
        }
      }
    },
    "favorites": {
      "type": "object",
      "title": "afbws.instrument.favorites.v2 — the caller's colored favorites (request / response)",
      "description": "Request: only `request_id`. Response: `favorites` in display order (array position is the order).",
      "required": [
        "channel",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.favorites.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "favorites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/favoriteEntry"
          }
        }
      }
    },
    "paint": {
      "type": "object",
      "title": "afbws.instrument.paint.v2 — additive delta on the caller's favorites (request / response)",
      "description": "No CAS: `mark` (paint or repaint), `unmark` (idempotent removal) and `order` (REPLACES the whole display order) are idempotent. Request: any of `mark`/`unmark`/`order`. Response: `marked`/`unmarked`/`order` — only the sections that were present in the request; `unmarked` lists only refs that really were favorites. A response is recognised by `marked`/`unmarked`; an `order`-only request and its echo have the same shape.",
      "required": [
        "channel",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.paint.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "mark": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/favoriteEntry"
          }
        },
        "unmark": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/favoriteRef"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/favoriteRef"
          }
        },
        "marked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/favoriteEntry"
          }
        },
        "unmarked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/favoriteRef"
          }
        }
      }
    },
    "expirationUsage": {
      "type": "object",
      "required": [
        "alarms",
        "primitives",
        "sets",
        "favorites"
      ],
      "additionalProperties": false,
      "properties": {
        "alarms": {
          "type": "integer",
          "minimum": 0
        },
        "primitives": {
          "type": "integer",
          "minimum": 0
        },
        "sets": {
          "type": "integer",
          "minimum": 0
        },
        "favorites": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expirationCandidate": {
      "type": "object",
      "required": [
        "instrument_key",
        "ticker",
        "expiration"
      ],
      "additionalProperties": false,
      "properties": {
        "instrument_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "expiration": {
          "type": "string",
          "format": "date"
        },
        "shortname": {
          "type": "string"
        }
      }
    },
    "expirationNotice": {
      "type": "object",
      "required": [
        "instrument_key",
        "ticker",
        "expiration",
        "days_left",
        "usage",
        "candidates"
      ],
      "additionalProperties": false,
      "description": "One expiring contract the caller uses, ready for the replace card (computed by the server). `ticker` is display only.",
      "properties": {
        "instrument_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "shortname": {
          "type": "string"
        },
        "expiration": {
          "type": "string",
          "format": "date"
        },
        "days_left": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "#/$defs/expirationUsage"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expirationCandidate"
          }
        }
      }
    },
    "expiration": {
      "type": "object",
      "title": "afbws.instrument.expiration.v2 — the caller's pending expiration notices (request / response / push)",
      "description": "Request: only `request_id`. Response: `items[]` nearest expiration first. The SAME schema is the server push: a message WITHOUT `request_id` carries the caller's full current list, which REPLACES the client's copy (an empty list clears the card).",
      "required": [
        "channel",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.expiration.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expirationNotice"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "request_id"
          ],
          "not": {
            "required": [
              "items"
            ]
          }
        },
        {
          "required": [
            "request_id",
            "items"
          ]
        },
        {
          "required": [
            "items"
          ],
          "not": {
            "required": [
              "request_id"
            ]
          }
        }
      ]
    },
    "replaceKind": {
      "enum": [
        "alarms",
        "primitives",
        "sets",
        "favorites"
      ]
    },
    "replaceRejection": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/replaceKind"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "enum": [
            "not_found",
            "validation_error",
            "conflict",
            "forbidden",
            "internal_error"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "replace": {
      "type": "object",
      "title": "afbws.instrument.replace.v2 — move the caller's structures from an expiring contract to another one (request / response)",
      "description": "Request: `from_key`, `to_key` (an ACTIVE contract of the same derivative) and optional `kinds` (default all four). Prices and levels are never adjusted. Partial results are normal: what could not be moved is in `rejected[]`. Idempotent. Response: the same keys plus `replaced` (counts), `rejected[]` and the refreshed `items[]` (as a fresh `expiration`).",
      "required": [
        "channel",
        "schema",
        "from_key",
        "to_key"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.replace.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "from_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        },
        "to_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/replaceKind"
          }
        },
        "replaced": {
          "$ref": "#/$defs/expirationUsage"
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/replaceRejection"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expirationNotice"
          }
        }
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "replaced"
                ]
              },
              {
                "required": [
                  "rejected"
                ]
              },
              {
                "required": [
                  "items"
                ]
              }
            ]
          },
          "required": [
            "request_id"
          ]
        },
        {
          "required": [
            "request_id",
            "replaced",
            "rejected",
            "items"
          ],
          "not": {
            "required": [
              "kinds"
            ]
          }
        }
      ]
    },
    "accountRef": {
      "type": "object",
      "required": [
        "bf_id",
        "account_id"
      ],
      "additionalProperties": false,
      "description": "A broker account (or the virtual one) of the caller. `account_id` is what the trading parameters depend on; `bf_id` accompanies it while an account id is unique only within a connector.",
      "properties": {
        "bf_id": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accountDetail": {
      "type": "object",
      "required": [
        "bf_id",
        "account_id",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "bf_id": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "error"
          ]
        },
        "scope": {
          "enum": [
            "account",
            "connector"
          ],
          "description": "`account` — the values are those of this very account; `connector` — the connector (BF) answered without account granularity, the values are connector-level."
        },
        "broker_instrument": {
          "type": "object",
          "additionalProperties": true,
          "description": "Trading parameters (tradable, longable, shortable, initial margins, price_type …) — BF-owned shape for real accounts, computed by AFB for the virtual one. Present when status is `ok`."
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "not_found",
                "bf_offline",
                "unsupported_action",
                "internal_error",
                "unavailable"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "scope",
              "broker_instrument"
            ],
            "properties": {
              "error": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "broker_instrument": false
            }
          }
        }
      ]
    },
    "detail": {
      "type": "object",
      "title": "afbws.instrument.detail.v2 — trading parameters of an instrument for every account of the caller (request / response)",
      "description": "Request: `instrument_key` and optionally `accounts[]` to narrow the answer; by default ALL accounts of the caller, the virtual one included. The tradeplan editor asks once when it opens (and when the instrument changes) and picks the selected account from `items[]`. Response (same `request_id`): `items[]` — one entry per account; a failure of one account is that entry's `status`/`error`, the others are unaffected. A whole-request error (`not_found` for an unknown key, `forbidden`, `unavailable` when there are no accounts) is `afbws.instrument.error.v2`. Any authenticated caller.",
      "required": [
        "channel",
        "schema",
        "instrument_key"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.detail.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "instrument_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/accountRef"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accountDetail"
          }
        }
      },
      "oneOf": [
        {
          "not": {
            "required": [
              "items"
            ]
          },
          "required": [
            "request_id"
          ]
        },
        {
          "required": [
            "request_id",
            "items"
          ],
          "not": {
            "required": [
              "accounts"
            ]
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "title": "afbws.instrument.error.v2 — typed error for a whole request (server -> client).",
      "description": "`details`: `catalog_revision` / `user_revision` for `conflict`; `set_ids` / `asset_ids` / `instrument_keys` naming the rows at fault for `forbidden` / `validation_error`; `limit` for a tier-limit overflow.",
      "required": [
        "channel",
        "schema",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "instrument"
        },
        "schema": {
          "const": "afbws.instrument.error.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "code": {
          "enum": [
            "forbidden",
            "invalid_schema",
            "invalid_channel",
            "unsupported_action",
            "validation_error",
            "not_found",
            "conflict",
            "bf_offline",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "catalog_revision": {
              "type": "integer"
            },
            "user_revision": {
              "type": "integer"
            },
            "set_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "asset_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "instrument_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limit": {
              "type": "object",
              "required": [
                "key",
                "allowed",
                "requested"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "allowed": {
                  "type": "integer",
                  "minimum": 0
                },
                "requested": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
