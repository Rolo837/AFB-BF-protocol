              "grant",
              "item"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "user_id"
                  ]
                },
                {
                  "required": [
                    "tier"
                  ]
                },
                {
                  "required": [
                    "ends_at"
                  ]
                },
                {
                  "required": [
                    "reason"
                  ]
                }
              ]
            }
          },
          "else": {
