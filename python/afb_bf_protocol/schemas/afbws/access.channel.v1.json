      }
    },
    "usersList": {
      "type": "object",
      "title": "afbws.access.users.list.v1 — list users with their effective access (request / response), manager only.",
      "description": "Request: optional filters (intersection): `tier`, `mode`, `lapsed` (true = subscription ended and not renewed — candidates for a manual grant), `query` (substring of user_id/display_name), paging `limit`/`offset`. Response: `items[]` (userRow, most recently seen first) + `total` (matching rows before paging).",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.users.list.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "tier": {
          "$ref": "common.v1.json#/$defs/accessTier"
        },
        "mode": {
          "$ref": "common.v1.json#/$defs/accessMode"
        },
        "lapsed": {
          "type": "boolean"
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/userRow"
          },
          "description": "Response only."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Response only."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "items"
            ]
          },
          "then": {
            "required": [
              "items",
              "total"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tier"
                  ]
                },
                {
                  "required": [
                    "mode"
                  ]
                },
                {
                  "required": [
                    "lapsed"
                  ]
                },
                {
                  "required": [
                    "query"
                  ]
                },
                {
                  "required": [
                    "limit"
                  ]
                },
                {
                  "required": [
                    "offset"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "total"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "userGet": {
      "type": "object",
      "title": "afbws.access.user.get.v1 — one user's card with history (request / response), manager only.",
      "description": "Request: `user_id`, optional `log_limit` (newest log entries, default 200). Response: `user_id`, `item` (userRow), `subscription_periods[]`, `trials[]`, `grants[]` (incl. revoked), `log[]` (newest first). Unknown user -> error `not_found`.",
      "required": [
        "channel",
        "schema",
        "request_id",
        "user_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.user.get.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "log_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 200
        },
        "item": {
          "$ref": "#/$defs/userRow"
        },
        "subscription_periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subscriptionPeriod"
          }
        },
        "trials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trial"
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        },
        "log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logEntry"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "item"
            ]
          },
          "then": {
            "required": [
              "item",
              "subscription_periods",
              "trials",
              "grants",
              "log"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "log_limit"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "subscription_periods"
                  ]
                },
                {
                  "required": [
                    "trials"
                  ]
                },
                {
                  "required": [
                    "grants"
                  ]
                },
                {
                  "required": [
                    "log"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "trialSet": {
      "type": "object",
      "title": "afbws.access.trial.set.v1 — manage a user's trial (request / response), manager only.",
      "description": "Request: `user_id`, `action` — `extend` (move the end of the current/last trial to `ends_at`), `start` (a new trial from now until `ends_at`; a repeated trial is possible only this way), `reset` (end the current trial now; no `ends_at`); optional `note`. Response: `user_id`, `item` (updated userRow), `trial` (the affected trial record).",
      "required": [
        "channel",
        "schema",
        "request_id",
        "user_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.trial.set.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "extend",
            "start",
            "reset"
          ]
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "item": {
          "$ref": "#/$defs/userRow"
        },
        "trial": {
          "$ref": "#/$defs/trial"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "item"
            ]
          },
          "then": {
            "required": [
              "item",
              "trial"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "action"
                  ]
                },
                {
                  "required": [
                    "ends_at"
                  ]
                },
                {
                  "required": [
                    "note"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "action"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "trial"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "extend",
                  "start"
                ]
              }
            }
          },
          "then": {
            "required": [
              "ends_at"
            ]
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "const": "reset"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "ends_at"
              ]
            }
          }
        }
      ]
    },
    "grantSet": {
      "type": "object",
      "title": "afbws.access.grant.set.v1 — grant standard access until a date (request / response), manager only.",
      "description": "Request: `user_id`, `tier` (only `user`), `ends_at` (future), optional `reason`. The grant starts now. Response: `grant` (the created record) + `item` (updated userRow).",
