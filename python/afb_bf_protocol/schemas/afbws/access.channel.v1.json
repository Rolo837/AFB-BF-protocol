          "type": "string",
          "minLength": 1
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "item": {
          "$ref": "#/$defs/userRow"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "grant"
            ]
          },
          "then": {
