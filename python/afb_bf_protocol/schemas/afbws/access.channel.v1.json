        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "const": "user"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "item": {
          "$ref": "#/$defs/userRow"
        }
      },
      "allOf": [
        {
          "if": {
