{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/afbws/access.channel.v1.json",
  "x-afbws-support-id": "afbws.access.channel.v1",
  "title": "access channel — schema-first (AFB backend<->AFB frontend only; not part of afb.execution.v1 wire)",
  "description": "Negotiated via auth.support (capability id afbws.access.channel.v1). Freemium access model: tier (who) x capabilities (personal permissions) x mode (what is available now), see common.v1.json#/$defs/access. Same convention as afbws.link/afbws.screener: ONE schema id per operation (`afbws.access.<op>.v1`, no .request/.response suffixes); the same schema is the request and its response (echoes `request_id`). `request_id` is required in every client request. Server-initiated messages: push `afbws.access.state.v1` (no `request_id`, new access block when the mode changes) and `afbws.access.denied.v1` — the gate's refusal of a request of ANY channel (sent on the refused request's channel, with its `request_id`). Whole-request failures of this channel: `afbws.access.error.v1`. Operations (manager only, others get `forbidden`): `roles.get`/`roles.set` (tiers, capabilities, local groups; replace the config-channel op `roles`), `settings.get`/`settings.set` (default tier, trial length, time windows, showcase; optimistic lock by `revision`), `users.list`, `user.get`, `trial.set`, `grant.set`, `grant.revoke`, `stats`. See AFB/docs/ws/access.md.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/rolesGet"
    },
    {
      "$ref": "#/$defs/rolesSet"
    },
    {
      "$ref": "#/$defs/settingsGet"
    },
    {
      "$ref": "#/$defs/settingsSet"
    },
    {
      "$ref": "#/$defs/usersList"
    },
    {
      "$ref": "#/$defs/userGet"
    },
    {
      "$ref": "#/$defs/trialSet"
    },
    {
      "$ref": "#/$defs/grantSet"
    },
    {
      "$ref": "#/$defs/grantRevoke"
    },
    {
      "$ref": "#/$defs/stats"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/denied"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "memberToken": {
      "type": "string",
      "pattern": "^(id_[a-zA-Z0-9]{1,10}|gc_[a-zA-Z0-9]{1,10}|id:.+|gc:.+)$",
      "description": "Member token: `id_<suffix>` (local user), `gc_<suffix>` (GetCourse user), `id:<local group id>`, `gc:<GetCourse group id>`."
    },
    "roleTier": {
      "type": "object",
      "required": [
        "title",
        "limits",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "limits": {
          "$ref": "common.v1.json#/$defs/accessLimits"
        },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/memberToken"
          }
        }
      }
    },
    "roleCapability": {
      "type": "object",
      "required": [
        "title",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/memberToken"
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "description": "Exactly the three tiers; each with title, limits and members.",
      "required": [
        "manager",
        "user",
        "guest"
      ],
      "additionalProperties": false,
      "properties": {
        "manager": {
          "$ref": "#/$defs/roleTier"
        },
        "user": {
          "$ref": "#/$defs/roleTier"
        },
        "guest": {
          "$ref": "#/$defs/roleTier"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Capability name -> {title, members}. Open set of names (`trade`, `virtual`, `screener`, `local`, ...).",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/roleCapability"
      }
    },
    "localGroup": {
      "type": "object",
      "description": "Local user group (members reference it as `id:<id>`).",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "getcourseGroup": {
      "type": "object",
      "description": "GetCourse group (members reference it as `gc:<id>`), normalized by the backend.",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "limitsTemplate": {
      "type": "object",
      "required": [
        "keys",
        "defaults"
      ],
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defaults": {
          "$ref": "common.v1.json#/$defs/accessLimits"
        }
      }
    },
    "window": {
      "description": "Daily time window, Moscow time. `from` == start, `to` == end (exclusive); `to` < `from` = across midnight (e.g. 22:00-02:00). null = no window on that kind of day.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/hhmm"
            },
            "to": {
              "$ref": "#/$defs/hhmm"
            }
          }
        }
      ]
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "showcase": {
      "type": "object",
      "description": "Instrument showcase: when `enabled`, a guest in `basic` gets `full` functionality for the instruments of catalog collection `collection` (null = empty showcase).",
      "required": [
        "enabled",
        "collection"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collection": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "settings": {
      "type": "object",
      "title": "Access settings document (server view).",
      "description": "Type of day (workday/weekend) comes from the MOEX trading calendar, fallback Sat/Sun.",
      "required": [
        "revision",
        "default_tier",
        "trial_days",
        "window_workday",
        "window_weekend",
        "showcase",
        "updated_at",
        "updated_by"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic document revision; settings.set must carry the revision it is based on (optimistic lock)."
        },
        "default_tier": {
          "type": "string",
          "enum": [
            "user",
            "guest"
          ],
          "description": "Tier of a user who matches no tier members."
        },
        "trial_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of the guest trial in days (0 = no trial)."
        },
        "window_workday": {
          "$ref": "#/$defs/window"
        },
        "window_weekend": {
          "$ref": "#/$defs/window"
        },
        "showcase": {
          "$ref": "#/$defs/showcase"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "user_id of the last editor."
        }
      }
    },
    "settingsInput": {
      "type": "object",
      "title": "settings.set input: `revision` + the top-level keys to replace (others unchanged).",
      "required": [
        "revision"
      ],
      "minProperties": 2,
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic document revision; settings.set must carry the revision it is based on (optimistic lock)."
        },
        "default_tier": {
          "type": "string",
          "enum": [
            "user",
            "guest"
          ],
          "description": "Tier of a user who matches no tier members."
        },
        "trial_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Length of the guest trial in days (0 = no trial)."
        },
        "window_workday": {
          "$ref": "#/$defs/window"
        },
        "window_weekend": {
          "$ref": "#/$defs/window"
        },
        "showcase": {
          "$ref": "#/$defs/showcase"
        }
      }
    },
    "userSource": {
      "type": "string",
      "enum": [
        "gc",
        "local",
        "demo"
      ],
      "description": "How the user logs in: GetCourse, local, demo."
    },
    "userRow": {
      "type": "object",
      "title": "One user in the manager's list (also the head of user.get).",
      "description": "`mode`/`reason`/`until` — effective access computed now (see common.v1.json#/$defs/access). `trial_ends_at`/`grant_ends_at` — end of the current or last trial/active grant (null — never). `subscription_started_at`/`subscription_ended_at` — the latest subscription period (`ended_at` null = still subscribed; both null = never subscribed).",
      "required": [
        "user_id",
        "display_name",
        "source",
        "tier",
        "capabilities",
        "mode",
        "reason",
        "until",
        "trial_ends_at",
        "grant_ends_at",
        "subscription_started_at",
        "subscription_ended_at",
        "first_seen_at",
        "last_seen_at"
      ],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/userSource"
        },
        "tier": {
          "$ref": "common.v1.json#/$defs/accessTier"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "$ref": "common.v1.json#/$defs/accessMode"
        },
        "reason": {
          "$ref": "common.v1.json#/$defs/accessReason"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "trial_ends_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "grant_ends_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "subscription_started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "subscription_ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "first_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "subscriptionPeriod": {
      "type": "object",
      "required": [
        "tier",
        "started_at",
        "ended_at",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "$ref": "common.v1.json#/$defs/accessTier"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "null = still open."
        },
        "source": {
          "type": "string",
          "enum": [
            "getcourse",
            "member",
            "grant"
          ],
          "description": "getcourse — GetCourse group; member — personal tier member; grant — manual grant."
        }
      }
    },
    "trial": {
      "type": "object",
      "required": [
        "started_at",
        "ends_at",
        "updated_by",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "Manager user_id of the last manual change; null — automatic start."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "grant": {
      "type": "object",
      "title": "Manual access extension (grace) by a manager.",
      "required": [
        "id",
        "user_id",
        "tier",
        "starts_at",
        "ends_at",
        "granted_by",
        "reason",
        "revoked_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "const": "user"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "granted_by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "null = not revoked."
        }
      }
    },
    "logEntry": {
      "type": "object",
      "required": [
        "ts",
        "event",
        "details"
      ],
      "additionalProperties": false,
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "description": "Open set; known values: tier_changed, capability_added, capability_removed, trial_started, trial_extended, trial_reset, grant_set, grant_revoked, mode_changed, denied."
        },
        "details": {
          "type": "object"
        }
      }
    },
    "cohort": {
      "type": "object",
      "description": "One cohort = guests first seen during the period starting `period_start` (Monday for `week`). Counters: `guests_new` — new guests; `trial_started` — of them started a trial; `active` — of them seen in the period after the trial; `converted` — of them became `user` (paid); `grants` — grants issued during the period.",
      "required": [
        "period_start",
        "guests_new",
        "trial_started",
        "active",
        "converted",
        "grants"
      ],
      "additionalProperties": false,
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "guests_new": {
          "type": "integer",
          "minimum": 0
        },
        "trial_started": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "converted": {
          "type": "integer",
          "minimum": 0
        },
        "grants": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deniedStat": {
      "type": "object",
      "required": [
        "feature",
        "count",
        "users"
      ],
      "additionalProperties": false,
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "users": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct users."
        }
      }
    },
    "deniedInstrumentStat": {
      "type": "object",
      "required": [
        "instrument_key",
        "count",
        "users"
      ],
      "additionalProperties": false,
      "properties": {
        "instrument_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "users": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rolesGet": {
      "type": "object",
      "title": "afbws.access.roles.get.v1 — read the tiers/capabilities/groups configuration (request / response), manager only.",
      "description": "Request: only `request_id`. Response: the full snapshot. Replaces the read half of the config-channel op `roles` (afbws.config.roles.v1), which the backend keeps serving from the same code.",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.roles.get.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "tiers": {
          "$ref": "#/$defs/tiers"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "local_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localGroup"
          }
        },
        "getcourse_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/getcourseGroup"
          },
          "description": "Response only."
        },
        "getcourse_groups_error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Response only: why GetCourse groups could not be fetched."
        },
        "limits_template": {
          "$ref": "#/$defs/limitsTemplate",
          "description": "Response only."
        },
        "default_tier": {
          "type": "string",
          "enum": [
            "user",
            "guest"
          ],
          "description": "Response only, read-only here (edited via settings.set)."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "limits_template"
            ]
          },
          "then": {
            "required": [
              "tiers",
              "capabilities",
              "local_groups",
              "getcourse_groups",
              "getcourse_groups_error",
              "limits_template",
              "default_tier"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tiers"
                  ]
                },
                {
                  "required": [
                    "capabilities"
                  ]
                },
                {
                  "required": [
                    "local_groups"
                  ]
                },
                {
                  "required": [
                    "getcourse_groups"
                  ]
                },
                {
                  "required": [
                    "getcourse_groups_error"
                  ]
                },
                {
                  "required": [
                    "limits_template"
                  ]
                },
                {
                  "required": [
                    "default_tier"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "rolesSet": {
      "type": "object",
      "title": "afbws.access.roles.set.v1 — replace the tiers/capabilities/local groups (request / response), manager only.",
      "description": "Request: `tiers` + `capabilities` (whole replacement), optional `local_groups` (omitted = unchanged). Response: the full snapshot after saving (same as roles.get).",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.roles.set.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "tiers": {
          "$ref": "#/$defs/tiers"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "local_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localGroup"
          }
        },
        "getcourse_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/getcourseGroup"
          },
          "description": "Response only."
        },
        "getcourse_groups_error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Response only: why GetCourse groups could not be fetched."
        },
        "limits_template": {
          "$ref": "#/$defs/limitsTemplate",
          "description": "Response only."
        },
        "default_tier": {
          "type": "string",
          "enum": [
            "user",
            "guest"
          ],
          "description": "Response only, read-only here (edited via settings.set)."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "limits_template"
            ]
          },
          "then": {
            "required": [
              "tiers",
              "capabilities",
              "local_groups",
              "getcourse_groups",
              "getcourse_groups_error",
              "limits_template",
              "default_tier"
            ]
          },
          "else": {
            "required": [
              "tiers",
              "capabilities"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "getcourse_groups"
                  ]
                },
                {
                  "required": [
                    "getcourse_groups_error"
                  ]
                },
                {
                  "required": [
                    "default_tier"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "settingsGet": {
      "type": "object",
      "title": "afbws.access.settings.get.v1 — read the access settings (request / response), manager only.",
      "description": "Request: only `request_id`. Response: `settings`.",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.settings.get.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        }
      }
    },
    "settingsSet": {
      "type": "object",
      "title": "afbws.access.settings.set.v1 — change the access settings (request / response), manager only.",
      "description": "Request: `settings` = settingsInput (`revision` the change is based on + top-level keys to replace). Response: the saved `settings` with a new `revision`. Revision mismatch -> afbws.access.error.v1 code `conflict` with the current document in `item`.",
      "required": [
        "channel",
        "schema",
        "request_id",
        "settings"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.settings.set.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/settings"
            },
            {
