    "stats": {
      "type": "object",
      "title": "afbws.access.stats.v1 — conversion statistics (request / response), manager only.",
      "description": "Request: `from`/`to` (dates, inclusive, Moscow), `group_by` (`week`). Response echoes `from`/`to`/`group_by` and carries `cohorts[]` (oldest first) and the top refusals: `denied[]` by feature and `denied_instruments[]` by instrument (showcase stage), both most frequent first.",
      "required": [
        "channel",
        "schema",
        "request_id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.stats.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "group_by": {
          "type": "string",
          "enum": [
            "week"
          ],
          "default": "week"
        },
        "cohorts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cohort"
          }
        },
        "denied": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deniedStat"
          }
        },
        "denied_instruments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deniedInstrumentStat"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "cohorts"
            ]
          },
          "then": {
            "required": [
              "cohorts",
              "denied",
              "denied_instruments",
              "group_by"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "denied"
                  ]
                },
                {
                  "required": [
                    "denied_instruments"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "title": "afbws.access.state.v1 — new effective access of this connection (server push only).",
      "description": "Sent without `request_id` whenever the effective access changes (mode switch at `until`, a trial/grant/settings change by a manager, a tier/capability change). Carries the whole new `access` block; the client replaces the one from auth.ok.",
      "required": [
        "channel",
        "schema",
        "access"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.state.v1"
        },
        "access": {
          "$ref": "common.v1.json#/$defs/access"
        }
      }
    },
    "denied": {
      "type": "object",
      "title": "afbws.access.denied.v1 — the access gate refused a request of ANY channel (server -> client).",
      "description": "Answer to a request of any schema-first channel that the current `mode` does not allow. `channel` is the channel of the REFUSED request (not `access`) and `request_id` echoes it, so the per-channel request/response client correlates and rejects the pending request. `reason`: `basic` — feature not available in basic mode; `showcase` — basic mode with showcase, the instrument(s) in `refs` are not in the showcase; `held` — activation of an alarm/trade plan while the owner's objects are held. `feature` — gate feature id (e.g. `datasets`, `participants`, `virtual`, `screener`, `alarm.activate`). `until` — when `full` becomes available (next window/trial), null if unknown. `message` — ready-to-show text.",
      "required": [
        "channel",
        "schema",
        "request_id",
        "reason",
        "feature",
        "until",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1,
          "description": "Channel of the refused request."
        },
        "schema": {
          "const": "afbws.access.denied.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "reason": {
          "type": "string",
          "enum": [
            "basic",
            "showcase",
            "held"
          ]
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.json#/$defs/instrumentKey"
          },
          "description": "Instruments that caused the refusal (showcase/held)."
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "title": "afbws.access.error.v1 — typed error for a whole request (server -> client).",
      "description": "`code` is a closed subset of common errorCode: `forbidden` (not a manager), `validation_error`, `not_found` (user/grant), `conflict` (settings.set revision mismatch; `item` = current settings document), `invalid_schema`, `internal_error`.",
      "required": [
        "channel",
        "schema",
        "request_id",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "access"
        },
        "schema": {
          "const": "afbws.access.error.v1"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "code": {
          "type": "string",
          "enum": [
            "forbidden",
            "validation_error",
            "not_found",
            "conflict",
            "invalid_schema",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "$ref": "#/$defs/settings"
        }
      },
      "if": {
        "required": [
          "item"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "const": "conflict"
          }
        }
      }
    }
  }
}
