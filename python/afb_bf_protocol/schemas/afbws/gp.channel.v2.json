{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/afbws/gp.channel.v2.json",
  "x-afbws-support-id": "afbws.gp.channel.v2",
  "title": "gp channel — schema-first (AFB backend<->AFB frontend only; not part of afb.execution.v1 wire)",
  "description": "Negotiated via auth.support/auth_ok.support (capability id afbws.gp.channel.v2). Full copy of gp.channel.v1 with items afb.gp.v2 (`instrument_key`, kinds trendline/fibonacci) plus chart-indicator management (replaces legacy settings/{get,set,get_default,set_default} `indicators`): `indicator.list` returns the caller's merged list (shared + personal); `indicator.set` is an upsert by id (personal for everyone; `scope: shared` only for a manager, otherwise `forbidden`; for an existing shared indicator a non-manager may change only the outer `enabled`); `indicator.delete` removes by id (shared: manager only). `indicator.sync` is a server push of changed/removed SHARED indicators to every connection with this capability. `list()` (no instrument_key) returns every primitive the caller owns. `set` is a plain upsert by item.id; the backend alone decides whether a move/delete is safe against linked tradeplans (typed conflict). See AFB/docs/ENTITY_WS_PROTOCOL.md.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/getRequest"
    },
    {
      "$ref": "#/$defs/getResponse"
    },
    {
      "$ref": "#/$defs/listRequest"
    },
    {
      "$ref": "#/$defs/listResponse"
    },
    {
      "$ref": "#/$defs/setRequest"
    },
    {
      "$ref": "#/$defs/setResponse"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/deleteResponse"
    },
    {
      "$ref": "#/$defs/syncPush"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/indicatorListRequest"
    },
    {
      "$ref": "#/$defs/indicatorListResponse"
    },
    {
      "$ref": "#/$defs/indicatorSetRequest"
    },
    {
      "$ref": "#/$defs/indicatorSetResponse"
    },
    {
      "$ref": "#/$defs/indicatorDeleteRequest"
    },
    {
      "$ref": "#/$defs/indicatorDeleteResponse"
    },
    {
      "$ref": "#/$defs/indicatorSyncPush"
    }
  ],
  "$defs": {
    "getRequest": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.get.request.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "getResponse": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "item"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.get.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "item": {
          "$ref": "../gp.v2.json"
        }
      }
    },
    "listRequest": {
      "type": "object",
      "title": "`instrument_key` omitted -> every primitive the caller owns across all instruments.",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.list.request.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "instrument_key": {
          "$ref": "common.v1.json#/$defs/instrumentKey"
        }
      }
    },
    "listResponse": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.list.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../gp.v2.json"
          }
        }
      }
    },
    "setRequest": {
      "type": "object",
      "title": "Upsert by item.id — moving a primitive is the same request as creating or editing one.",
      "required": [
        "channel",
        "schema",
        "request_id",
        "item"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.set.request.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "item": {
          "$ref": "../gp.v2.json"
        }
      }
    },
    "setResponse": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "item"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.set.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "item": {
          "$ref": "../gp.v2.json"
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.delete.request.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deleteResponse": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.delete.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "syncPush": {
      "type": "object",
      "title": "gp/sync push (server-initiated, no request_id) — ownership delta by id",
      "description": "items[] — upsert by id (bind: tradeplan_id set on publish/amend; release: tradeplan_id cleared on plan physical delete), full authoritative afb.gp.v2 record, same shape as set.response. Never a snapshot. Primitive deletion (archival freeze) is NOT conveyed by this push — a dropped primitive was, by construction, bound to a plan and only rendered while that plan is selected; the plan's own afbws.tradeplan.sync.push.v1 (status: archived, frozen numeric conditions) already replaces its on-chart representation.",
      "required": [
        "channel",
        "schema",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.sync.push.v2"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../gp.v2.json"
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "title": "typed error; `item` carries the authoritative current record when a caller needs to see it (e.g. a rejected move/delete restores the server's version, not the client's optimistic one).",
      "required": [
        "channel",
        "schema",
        "request_id",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.error.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "code": {
          "$ref": "common.v1.json#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "$ref": "../gp.v2.json"
        },
        "details": {
          "$ref": "#/$defs/errorDetails"
        }
      }
    },
    "errorDetails": {
      "type": "object",
      "title": "Which linked tradeplans/deals blocked a delete/move, and which scopes are locked — populated on `conflict`.",
      "additionalProperties": false,
      "properties": {
        "tradeplan_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deal_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locked_scopes": {
          "type": "array",
          "items": {
            "enum": [
              "entry",
              "stop_loss",
              "take_profit"
            ]
          }
        }
      }
    },
    "indicatorListRequest": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.indicator.list.request.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        }
      }
    },
    "indicatorListResponse": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.indicator.list.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../gp.v2.json#/$defs/indicator"
          }
        }
      }
    },
    "indicatorSetRequest": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "item"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.indicator.set.request.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "item": {
          "$ref": "../gp.v2.json#/$defs/indicator"
        }
      }
    },
    "indicatorSetResponse": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "item"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.indicator.set.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "item": {
          "$ref": "../gp.v2.json#/$defs/indicator"
        }
      }
    },
    "indicatorDeleteRequest": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.indicator.delete.request.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "indicatorDeleteResponse": {
      "type": "object",
      "required": [
        "channel",
        "schema",
        "request_id",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.indicator.delete.response.v2"
        },
        "request_id": {
          "$ref": "common.v1.json#/$defs/requestId"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "indicatorSyncPush": {
      "type": "object",
      "title": "gp/indicator.sync push (server-initiated, no request_id) — delta of SHARED indicators",
      "description": "items[] — upsert by id (full authoritative record); removed_ids[] — shared indicators deleted by a manager. At least one of them is non-empty. Personal indicators are never pushed (each user's own set/delete is answered by its response).",
      "required": [
        "channel",
        "schema"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "items"
          ]
        },
        {
          "required": [
            "removed_ids"
          ]
        }
      ],
      "properties": {
        "channel": {
          "const": "gp"
        },
        "schema": {
          "const": "afbws.gp.indicator.sync.push.v2"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../gp.v2.json#/$defs/indicator"
          }
        },
        "removed_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
