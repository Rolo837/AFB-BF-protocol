{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rolo837/AFB-BF-protocol/spec/schemas/afbws/deal.channel.v1.json",
  "x-afbws-support-id": "afbws.deal.channel.v1",
  "title": "deal channel — schema-first (AFB backend<->AFB frontend only; not part of afb.execution.v1 wire)",
  "description": "Negotiated via auth.support/auth_ok.support (capability id afbws.deal.channel.v1) — the sole entry point for `channel=deal`, the AFB legacy schema-less transport was removed. `item`/`items`/`results` never carry the persisted DealState file shape (source_refs, status_history, event_journal, raw orders/positions, observed) — see $defs/dealSummary and $defs/dealDetail, built by backend/trade/public_views.py as explicit allow-list projections. The publish/rebind/amend RPCs resolve the source tradeplan only via deal.source.tradeplan_id (deal.public.v1.json); they never accept an inline plan-like draft. See AFB/docs/ws/deal.md.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/getRequest" },
    { "$ref": "#/$defs/getResponse" },
    { "$ref": "#/$defs/listRequest" },
    { "$ref": "#/$defs/listResponse" },
    { "$ref": "#/$defs/publishRequest" },
    { "$ref": "#/$defs/publishResponse" },
    { "$ref": "#/$defs/rebindRequest" },
    { "$ref": "#/$defs/rebindResponse" },
    { "$ref": "#/$defs/operationRequest" },
    { "$ref": "#/$defs/operationResponse" },
    { "$ref": "#/$defs/amendRequest" },
    { "$ref": "#/$defs/amendResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "deal.record.v1.json" },
    { "$ref": "deal.pnl.v1.json" },
    { "$ref": "deal.event.v1.json" },
    { "$ref": "#/$defs/triggeredPush" },
    { "$ref": "#/$defs/ackRequest" },
    { "$ref": "#/$defs/ackResponse" }
  ],
  "$defs": {
    "dealId": { "type": "string", "minLength": 1 },
    "bfId": { "type": "string", "minLength": 1 },
    "amendField": { "enum": ["entry", "sizing", "stop_loss", "take_profit", "execution_policy"] },
    "dealSizingDisplay": {
      "type": "object",
      "title": "Broker-sizing display projection (lots/required_cash/...) needed by the Deals widget row/editor — not the raw compiled sizing block.",
      "additionalProperties": false,
      "properties": {
        "lots": { "type": "integer" },
        "required_cash": { "type": "string" },
        "resolved_lots": { "type": "integer", "description": "BF-resolved actual order quantity (lots), fixed once at entry-trigger time — distinct from `lots`, which stays the pre-trade publish estimate. Present only once BF has reported it (deal.status_changed/deal.snapshot `quantity`)." }
      }
    },
    "dealRealizedPnl": {
      "type": "object",
      "title": "AFB-computed realized P&L (rubles), projected from the internal source_refs.afb_pnl ledger — never the raw ledger itself (computed_at/bf_realized_points/schema stay internal). Absent entirely means no ledger yet (deal predates it, or hasn't had an exit fill) — distinct from a present-but-degraded value.",
      "required": ["value", "degraded"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["string", "null"],
          "description": "Decimal string, rubles. Null exactly when degraded is set — a fill's money multiplier (step_price/price_step or lot_size) couldn't be resolved."
        },
        "degraded": { "enum": [null, "missing_price", "missing_step_price"] }
      },
      "if": { "properties": { "degraded": { "const": null } } },
      "else": { "properties": { "value": { "const": null } } }
    },
    "dealSummary": {
      "type": "object",
      "title": "Minimal row/card projection for list — no compiled deal body, no source_refs, no journals. `sizing` is the user-set {mode,value} from the «Риск и объём» block (at publish or last amend) — NOT the broker_sizing projection, see `broker_sizing` below for that.",
      "required": ["deal_id", "revision", "status", "execution_phase", "bf_id", "tradeplan_id", "ticker", "direction", "created_at", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "deal_id": { "$ref": "#/$defs/dealId" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "execution_phase": { "type": "string" },
        "bf_id": { "$ref": "#/$defs/bfId" },
        "tradeplan_id": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string" },
        "market": { "enum": ["stock", "futures", "currency"] },
        "direction": { "enum": ["long", "short"] },
        "sizing": { "$ref": "../common.v1.json#/$defs/sizing" },
        "execution_policy": { "$ref": "../common.v1.json#/$defs/executionPolicy" },
        "broker_sizing": { "$ref": "#/$defs/dealSizingDisplay" },
        "realized_pnl": { "$ref": "#/$defs/dealRealizedPnl" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "dealDetail": {
      "type": "object",
      "title": "Full editor payload for get() — dealSummary + the compiled public deal + phase-B amendability projection.",
      "required": ["deal_id", "revision", "status", "execution_phase", "bf_id", "tradeplan_id", "ticker", "direction", "created_at", "updated_at", "deal", "editable_fields"],
      "additionalProperties": false,
      "properties": {
        "deal_id": { "$ref": "#/$defs/dealId" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "execution_phase": { "type": "string" },
        "bf_id": { "$ref": "#/$defs/bfId" },
        "tradeplan_id": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string" },
        "market": { "enum": ["stock", "futures", "currency"] },
        "direction": { "enum": ["long", "short"] },
        "sizing": { "$ref": "../common.v1.json#/$defs/sizing" },
        "execution_policy": { "$ref": "../common.v1.json#/$defs/executionPolicy" },
        "broker_sizing": { "$ref": "#/$defs/dealSizingDisplay" },
        "realized_pnl": { "$ref": "#/$defs/dealRealizedPnl" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "deal": { "$ref": "deal.public.v1.json" },
        "editable_fields": { "type": "array", "items": { "$ref": "#/$defs/amendField" } }
      }
    },
    "dealLegEdit": {
      "type": "object",
      "title": "Edit of one EXISTING leg, by its current index in the deal's role array — never by leg_id (BF/deal-side has no leg_id, only AFB's tradeplan does).",
      "required": ["index"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "condition": { "$ref": "../deal.v2.json#/$defs/conditionNode" },
        "percent": { "$ref": "../common.v1.json#/$defs/decimalString" },
        "logic": { "$ref": "../deal.v2.json#/$defs/legJoin" }
      }
    },
    "dealNewLeg": {
      "type": "object",
      "title": "A brand-new deal-only leg (no linked tradeplan leg) — always source=deal, appended at the end of the role's array.",
      "required": ["condition"],
      "additionalProperties": false,
      "properties": {
        "condition": { "$ref": "../deal.v2.json#/$defs/conditionNode" },
        "percent": { "$ref": "../common.v1.json#/$defs/decimalString" },
        "logic": { "$ref": "../deal.v2.json#/$defs/legJoin" }
      }
    },
    "dealRoleEdit": {
      "type": "object",
      "title": "Per-role (entry/stop_loss/take_profit) leg-level edit fragment. Indices refer to the CURRENT deal's leg array for that role at base_revision — never a tradeplan's, never leg_id. edited/removed_indices/reset_indices apply to existing legs; new_legs are appended after them. See AFB backend/tradeplans/overrides.py::apply_deal_edit for the exact merge order.",
      "additionalProperties": false,
      "properties": {
        "edited": { "type": "array", "items": { "$ref": "#/$defs/dealLegEdit" } },
        "removed_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "reset_indices": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "Drop this leg's deal-level override (source reverts to tradeplan) — the leg immediately re-adopts whatever the linked plan currently holds for the matching leg_id."
        },
        "new_legs": { "type": "array", "items": { "$ref": "#/$defs/dealNewLeg" } }
      }
    },
    "dealEdit": {
      "type": "object",
      "title": "Amend fragment (afbws.deal.amend.request.v1#/deal_edit) — per-role leg edits plus whole-value overrides for sizing/execution_policy (replace wholesale, no partial-field merge).",
      "additionalProperties": false,
      "properties": {
        "entry": { "$ref": "#/$defs/dealRoleEdit" },
        "stop_loss": { "$ref": "#/$defs/dealRoleEdit" },
        "take_profit": { "$ref": "#/$defs/dealRoleEdit" },
        "sizing": { "$ref": "../common.v1.json#/$defs/sizing" },
        "execution_policy": { "$ref": "../common.v1.json#/$defs/executionPolicy" }
      }
    },
    "dealResult": {
      "type": "object",
      "required": ["deal_id", "bf_id", "status", "accepted"],
      "additionalProperties": false,
      "properties": {
        "deal_id": { "$ref": "#/$defs/dealId" },
        "bf_id": { "$ref": "#/$defs/bfId" },
        "status": { "type": "string" },
        "accepted": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 1 },
        "item": {
          "oneOf": [
            { "$ref": "#/$defs/dealSummary" },
            { "$ref": "#/$defs/dealDetail" }
          ]
        },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },

    "getRequest": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "deal_id"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.get.request.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "deal_id": { "$ref": "#/$defs/dealId" }
      }
    },
    "getResponse": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "item"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.get.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "item": { "$ref": "#/$defs/dealDetail" }
      }
    },

    "listRequest": {
      "type": "object",
      "title": "No filters in v1 — plan->deals grouping is built on the frontend from the snapshot's tradeplan_id, not a server-side filter.",
      "required": ["channel", "schema", "request_id"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.list.request.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" }
      }
    },
    "listResponse": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "items"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.list.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/dealSummary" } }
      }
    },

    "publishRequest": {
      "type": "object",
      "title": "Publishes an already-saved tradeplan. No inline plan-like draft, no plural bf_ids — v1 stays 1:1 (see §2.3/§2.6 of the migration plan); a future kratnost' phase extends this contract separately.",
      "required": ["channel", "schema", "request_id", "tradeplan_id", "bf_id"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.publish.request.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "tradeplan_id": { "type": "string", "minLength": 1 },
        "bf_id": { "$ref": "#/$defs/bfId" }
      }
    },
    "publishResponse": {
      "type": "object",
      "title": "results[] is batch-shaped to match the existing service's return contract; v1 publish always yields at most one element.",
      "required": ["channel", "schema", "request_id", "results", "accepted"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.publish.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/dealResult" } },
        "accepted": { "type": "boolean" }
      }
    },

    "rebindRequest": {
      "type": "object",
      "title": "Addresses the deal, not a plan draft — the backend resolves the source tradeplan via the existing deal's deal.source.tradeplan_id.",
      "required": ["channel", "schema", "request_id", "deal_id", "bf_id"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.rebind.request.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "deal_id": { "$ref": "#/$defs/dealId" },
        "bf_id": { "$ref": "#/$defs/bfId" }
      }
    },
    "rebindResponse": {
      "type": "object",
      "title": "If the new target changes the deal id, results[0].deal_id/item carry the NEW id — the frontend must drop the old cache key and upsert the new one.",
      "required": ["channel", "schema", "request_id", "results", "accepted"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.rebind.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/dealResult" } },
        "accepted": { "type": "boolean" }
      }
    },

    "operationItem": {
      "type": "object",
      "required": ["deal_id", "action"],
      "additionalProperties": false,
      "properties": {
        "deal_id": { "$ref": "#/$defs/dealId" },
        "action": {
          "enum": ["activate", "pause", "resume", "cancel", "reconcile", "delete"]
        },
        "revision": { "type": "integer", "minimum": 1 },
        "cancel_open_orders": { "type": "boolean", "description": "Only meaningful for action='cancel' — see the allOf guard below." }
      },
      "allOf": [
        {
          "if": { "required": ["cancel_open_orders"] },
          "then": { "properties": { "action": { "const": "cancel" } } }
        }
      ]
    },
    "operationRequest": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "items"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.operation.request.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operationItem" } }
      }
    },
    "operationResponse": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "results", "accepted"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.operation.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/dealResult" } },
        "accepted": { "type": "boolean", "description": "any(result.accepted for result in results)" }
      }
    },

    "amendRequest": {
      "type": "object",
      "title": "Per-leg amend (tradeplan/deal separation Фаза B2) — deal_edit carries only the legs/fields actually overridden on the deal side; anything omitted keeps following its linked tradeplan.",
      "required": ["channel", "schema", "request_id", "deal_id"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.amend.request.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "deal_id": { "$ref": "#/$defs/dealId" },
        "deal_edit": { "$ref": "#/$defs/dealEdit" },
        "base_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "amendResponse": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "item", "revision", "status", "accepted"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.amend.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "item": { "$ref": "#/$defs/dealDetail" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "accepted": { "type": "boolean" }
      }
    },

    "errorResponse": {
      "type": "object",
      "title": "item is populated for conflict recovery (e.g. a rebind/amend racing a concurrent status change) so the frontend can adopt the authoritative record instead of retrying blind.",
      "required": ["channel", "schema", "request_id", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.error.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "code": { "$ref": "common.v1.json#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" },
        "item": {
          "oneOf": [
            { "$ref": "#/$defs/dealSummary" },
            { "$ref": "#/$defs/dealDetail" }
          ]
        }
      }
    },

    "triggerEvent": {
      "type": "object",
      "title": "Schema analogue of the legacy TriggeredDealItem — not the MQTT notification.deal.v1 payload (different transport).",
      "required": ["schema", "notification_id", "deal_id", "bf_id", "event", "created_at", "data"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "afb.deal.trigger.v1" },
        "notification_id": { "type": "string", "minLength": 1 },
        "deal_id": { "$ref": "#/$defs/dealId" },
        "bf_id": { "$ref": "#/$defs/bfId" },
        "event": { "type": "string" },
        "created_at": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "triggeredPush": {
      "type": "object",
      "title": "deal/triggered push (server-initiated, no request_id) — guaranteed delivery, same ack discipline as alarms: reconnect redelivers unacked events.",
      "required": ["channel", "schema", "events"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.triggered.push.v1" },
        "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/triggerEvent" } }
      }
    },
    "ackEvent": {
      "type": "object",
      "required": ["schema", "notification_id"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "afb.deal.trigger_ack.v1" },
        "notification_id": { "type": "string", "minLength": 1 }
      }
    },
    "ackRequest": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "events"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.ack.request.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ackEvent" } }
      }
    },
    "ackResultItem": {
      "type": "object",
      "required": ["schema", "notification_id", "status"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "afbws.deal.ack_result.v1" },
        "notification_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ok", "not_found"] }
      }
    },
    "ackResponse": {
      "type": "object",
      "required": ["channel", "schema", "request_id", "results"],
      "additionalProperties": false,
      "properties": {
        "channel": { "const": "deal" },
        "schema": { "const": "afbws.deal.ack.response.v1" },
        "request_id": { "$ref": "common.v1.json#/$defs/requestId" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/ackResultItem" } }
      }
    }
  }
}
